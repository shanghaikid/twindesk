{
  "name": "twindesk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "adapter:check": "node scripts/check-adapter-output.mjs",
    "build": "tsc -b && node scripts/build-client-plugin.mjs",
    "client:build": "node scripts/build-client-plugin.mjs",
    "compat:check": "node scripts/check-harness-compatibility.mjs",
    "clean": "tsc -b --clean && node scripts/build-client-plugin.mjs clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "profile:check": "node scripts/harness-profile.mjs check",
    "profile:config": "node scripts/harness-profile.mjs dump",
    "profile:prepare": "node scripts/harness-profile.mjs prepare",
    "profile:start": "node scripts/harness-profile.mjs start",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    "test": "tsc -b && node scripts/build-client-plugin.mjs && node --test",
    "repo:check": "node scripts/check-repository.mjs",
    "check": "node scripts/check-all.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  }
}
