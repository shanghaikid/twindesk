{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2023",
    "paths": {
      "@twindesk/harness-adapter": ["./packages/harness-adapter/src/index.ts"]
    },
    "verbatimModuleSyntax": true
  }
}
